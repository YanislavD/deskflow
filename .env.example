# Kopiere diese Datei nach ".env" und trage die Werte aus deinem Supabase-Projekt ein
# (Dashboard -> Project Settings -> API).
# Nur den öffentlichen "anon"/"publishable" Key verwenden – NIEMALS den service_role Key im Frontend.
VITE_SUPABASE_URL=https://dein-projekt.supabase.co
VITE_SUPABASE_ANON_KEY=dein-anon-key
