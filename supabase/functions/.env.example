# Umgebungsvariablen für die Edge Function "send-emails".
# Lokal: Datei nach "supabase/functions/.env" kopieren (steht in .gitignore).
# In der Cloud: `supabase secrets set --env-file supabase/functions/.env`

# Muss mit dem Wert "email_sender_secret" in private.app_settings übereinstimmen.
EMAIL_WEBHOOK_SECRET=local-dev-secret

# Lokal landen die E-Mails in Mailpit (http://127.0.0.1:54324). "inbucket" ist der Name des Containers im Docker-Netzwerk.
SMTP_HOST=inbucket
SMTP_PORT=1025
SMTP_TLS=false
# SMTP_USER=
# SMTP_PASS=

MAIL_FROM=DeskFlow <noreply@deskflow.local>
